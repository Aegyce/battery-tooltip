<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Battery Tooltip" Width="308" SizeToContent="Height"
        ResizeMode="NoResize" WindowStyle="SingleBorderWindow" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
  <Grid Margin="8" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock x:Name="StateLabel" FontSize="13" VerticalAlignment="Center"/>
    <Grid Grid.Row="1" Margin="0,6,0,6">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <CheckBox x:Name="StartupCheck" VerticalContentAlignment="Center" VerticalAlignment="Center"/>
      <Button x:Name="UpdateButton" Grid.Column="1" Height="22" Padding="6,0" FontSize="11"/>
    </Grid>
    <UniformGrid Grid.Row="2" Rows="1" Columns="4">
      <Button x:Name="ActionButton" Height="26" Margin="0,0,4,0"/>
      <Button x:Name="StopButton" Height="26" Margin="0,0,4,0"/>
      <Button x:Name="UninstallButton" Height="26" Margin="0,0,4,0"/>
      <Button x:Name="CloseButton" Height="26" IsCancel="True"/>
    </UniformGrid>
    <TextBlock x:Name="ErrorLabel" Grid.Row="3" FontSize="11" Foreground="Firebrick"
               TextWrapping="Wrap" MaxHeight="48" Margin="0,6,0,0" Visibility="Collapsed"/>
  </Grid>
</Window>
